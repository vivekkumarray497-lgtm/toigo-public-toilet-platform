# TOIGO Environment Configuration Template
# Duplicate this file to server/.env and provide your credentials.

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000,http://127.0.0.1:5000

JWT_SECRET=toigo_production_secret_key_2026_change_in_prod
MONGODB_URI=

RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
EMAIL_FROM="TOIGO Sanitation Network" <no-reply@toigo.app>

FIREBASE_PROJECT_ID=toigo-sanitation-app
