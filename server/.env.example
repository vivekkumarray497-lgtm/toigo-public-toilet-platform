# TOIGO Environment Configuration Template
# Duplicate this file to .env and provide your production/staging credentials.

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Application Frontend Allowed Origin(s) (comma-separated for multiple)
FRONTEND_URL=http://localhost:5000,http://127.0.0.1:5000

# JSON Web Token Secret (Required in production)
JWT_SECRET=toigo_production_secret_key_2026_change_in_prod

# MongoDB Connection URI (Optional: Leave empty for built-in persistent JSON storage)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/toigo_db?retryWrites=true&w=majority
MONGODB_URI=

# Razorpay Payment Gateway (Test or Live keys from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Google OAuth 2.0 / OIDC (Credentials from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# SMTP Email Configuration (Nodemailer for OTP & notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
EMAIL_FROM="TOIGO Sanitation Network" <no-reply@toigo.app>

# Firebase Cloud Messaging (Optional: For native mobile push notifications)
FIREBASE_PROJECT_ID=toigo-sanitation-app
